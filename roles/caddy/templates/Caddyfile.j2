:{{ caddy_docker_port }} {
	handle_path /couch* {
		reverse_proxy {{ vms.services.ip }}:{{couchdb_port}}
	}

	handle /vaultwarden* {
		reverse_proxy {{ vms.services.ip }}:{{ vaultwarden_port }}
	}

	handle /uptime {
		redir /uptime/dashboard permanent
	}

	handle_path /uptime/* {
		reverse_proxy 127.0.0.1:3001
	}

	redir /.well-known/caldav /nextcloud/remote.php/dav/ permanent
	redir /.well-known/carddav /nextcloud/remote.php/dav/ permanent

	# Built-in Nextcloud Office may emit CODE asset URLs without the webroot
	# prefix. Keep those narrowly scoped paths reachable through the same app.
	handle /custom_apps/richdocumentscode/* {
		reverse_proxy {{ vms.nextcloud.ip }}:{{ vms.nextcloud.port }} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	handle /nextcloud {
		redir /nextcloud/ permanent
	}

	handle_path /nextcloud/* {
		reverse_proxy {{ vms.nextcloud.ip }}:{{ vms.nextcloud.port }} {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Prefix /nextcloud
	}
	}

	handle {
		respond "caddy in running in docker"
	}


}

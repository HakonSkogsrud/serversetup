:{{ caddy_docker_port }} {
	handle_path /couch* {
		reverse_proxy {{ vms.services.ip }}:{{couchdb_port}}
	}

	handle /vaultwarden* {
		reverse_proxy {{ vms.services.ip }}:{{ vaultwarden_port }}
	}

	handle /uptime {
		redir /uptime/dashboard permanent
	}

	handle_path /uptime/* {
		reverse_proxy 127.0.0.1:3001
	}

	redir /.well-known/caldav /nextcloud/remote.php/dav/ permanent
	redir /.well-known/carddav /nextcloud/remote.php/dav/ permanent

	# Serve the document editor through the existing hostname so the browser and
	# Nextcloud stay same-origin. The upstream uses X-Forwarded-Prefix when
	# generating its asset and WebSocket URLs.
	handle /office {
		redir /office/ permanent
	}

	handle_path /office/* {
		reverse_proxy {{ vms.nextcloud.ip }}:{{ vms.nextcloud.eurooffice_port }} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Prefix /office
		}
	}

	handle /nextcloud {
		redir /nextcloud/ permanent
	}

	handle_path /nextcloud/* {
		reverse_proxy {{ vms.nextcloud.ip }}:{{ vms.nextcloud.port }} {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Prefix /nextcloud
	}
	}

	handle {
		respond "caddy in running in docker"
	}


}

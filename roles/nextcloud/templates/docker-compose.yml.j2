---
services:
  db:
    image: postgres:{{ nextcloud_postgres_version }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: {{ nextcloud_db_name | to_json }}
      POSTGRES_USER: {{ nextcloud_db_user | to_json }}
      POSTGRES_PASSWORD: {{ nextcloud_db_password | to_json }}
    volumes:
      - {{ nextcloud_postgres_path }}:/var/lib/postgresql/data:Z
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ nextcloud_db_user }} -d {{ nextcloud_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 10

  redis:
    image: redis:{{ nextcloud_redis_version }}
    restart: unless-stopped
    command: redis-server --save "" --appendonly no

  eurooffice:
    image: ghcr.io/euro-office/documentserver:{{ nextcloud_eurooffice_version }}
    restart: unless-stopped
    ports:
      - "{{ vms.nextcloud.ip }}:{{ nextcloud_eurooffice_http_port }}:80"
    environment:
      JWT_ENABLED: "true"
      JWT_SECRET: {{ eurooffice_jwt_secret | to_json }}
      # EuroOffice fetches file content and callback URLs directly from the
      # Nextcloud container on this private Compose network.
      ALLOW_PRIVATE_IP_ADDRESS: "true"
    # This image cannot initialise with empty host-mounted config or log
    # directories. Its collaboration working state is disposable; Nextcloud's
    # persistent data and database remain the authoritative document store.

  # EuroOffice calls Nextcloud with the public /nextcloud path. This internal
  # proxy removes that path before forwarding to Apache at the app root.
  nextcloud-internal:
    image: nginx:1.27-alpine
    restart: unless-stopped
    volumes:
      - ./nextcloud-internal.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - app

  app: &nextcloud_app
    image: nextcloud:{{ nextcloud_version }}
    restart: unless-stopped
    ports:
      - "{{ vms.nextcloud.ip }}:{{ nextcloud_http_port }}:80"
    environment: &nextcloud_environment
      POSTGRES_HOST: "db"
      POSTGRES_DB: {{ nextcloud_db_name | to_json }}
      POSTGRES_USER: {{ nextcloud_db_user | to_json }}
      POSTGRES_PASSWORD: {{ nextcloud_db_password | to_json }}
      REDIS_HOST: "redis"
      NEXTCLOUD_ADMIN_USER: {{ nextcloud_admin_user | to_json }}
      NEXTCLOUD_ADMIN_PASSWORD: {{ nextcloud_admin_password | to_json }}
      NEXTCLOUD_DATA_DIR: /var/www/html/data
      NEXTCLOUD_TRUSTED_DOMAINS: "nextcloud {{ vms.nextcloud.ip }} {{ nextcloud_external_hostname }}"
      TRUSTED_PROXIES: {{ vms.services.ip | to_json }}
      OVERWRITEPROTOCOL: "https"
      OVERWRITEHOST: {{ nextcloud_external_hostname | to_json }}
      OVERWRITEWEBROOT: {{ nextcloud_external_path | to_json }}
      OVERWRITECLIURL: {{ ('https://' ~ nextcloud_external_hostname ~ nextcloud_external_path) | to_json }}
      PHP_MEMORY_LIMIT: "512M"
      PHP_UPLOAD_LIMIT: "10G"
    volumes: &nextcloud_volumes
      - {{ nextcloud_data_path }}:/var/www/html/data:Z
      - {{ nextcloud_config_path }}:/var/www/html/config:Z
      - {{ nextcloud_custom_apps_path }}:/var/www/html/custom_apps:Z
      - {{ nextcloud_themes_path }}:/var/www/html/themes:Z
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started

  cron:
    <<: *nextcloud_app
    entrypoint: /cron.sh
    ports: []
    environment: *nextcloud_environment
    volumes: *nextcloud_volumes

networks:
  default:
    name: nextcloud

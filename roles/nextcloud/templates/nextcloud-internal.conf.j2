server {
    listen 80;

    location = /nextcloud {
        return 301 /nextcloud/;
    }

    location /nextcloud/ {
        proxy_pass http://app/;
        proxy_set_header Host nextcloud;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }
}

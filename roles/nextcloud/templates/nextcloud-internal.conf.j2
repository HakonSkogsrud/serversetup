resolver 127.0.0.11 valid=10s ipv6=off;

upstream nextcloud_app {
    zone nextcloud_app 64k;
    server app:80 resolve;
}

server {
    listen 80;

    location = /nextcloud {
        return 301 /nextcloud/;
    }

    location /nextcloud/ {
        proxy_pass http://nextcloud_app/;
        proxy_set_header Host nextcloud;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }

    # EuroOffice uses this internal address for callbacks and downloads. Its
    # connector can emit either the public webroot-prefixed form above or an
    # app-root path such as /apps/eurooffice/track.
    location / {
        proxy_pass http://nextcloud_app;
        proxy_set_header Host nextcloud;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }
}
